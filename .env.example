NODE_ENV=development
PORT=8003

# Local docker-compose mongo; swap for an Atlas SRV URI in prod.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bangkoktor

# Set to "true" to log every mongoose query (dev only).
MONGOOSE_DEBUG=false

# politeFetch (NFR-07) — the only door out to a government host.
# The UA must carry a real contact address; it is how a portal owner reaches us
# instead of blocking us.
HTTP_USER_AGENT=BangkokTOR/0.1 (+mailto:you@example.com)
# Minimum gap between two requests to the SAME host.
HTTP_DELAY_MS=400
HTTP_TIMEOUT_MS=30000
# Total tries, not retries. 1 means never retry.
HTTP_MAX_ATTEMPTS=4

# Ingestion (Source B: CKAN opend.data.go.th -> process5.gprocurement.go.th).
# Required to RUN ingestion, not to boot the API. Get a token from data.go.th.
DATAGOTH_KEY=
CKAN_RESOURCE_ID=e4eaa1b4-eb1a-4534-b227-988ee25b898d
BLOB_DIR=./data/blobs

# Worker. Lease must exceed the slowest honest fetch, or a live worker's row
# gets reclaimed underneath it.
WORKER_LEASE_MS=900000
WORKER_IDLE_MS=5000
WORKER_MAX_ATTEMPTS=3
# Largest bundle verified live is 512,452,129 bytes. Past this the fetch is
# recorded as `oversize` (a typed outcome, not silent loss) rather than filling
# the disk. Raise it with evidence, not optimism.
MAX_BUNDLE_BYTES=200000000

# Extraction (past the AGENTS.md §4 handoff boundary).
EXTRACT_DIR=./data/extracted
# Zip-bomb guards. A bundle expanding past either is refused.
MAX_ZIP_ENTRIES=200
MAX_UNZIPPED_BYTES=1000000000

# AI grading. "ollama" today; "vertex" once Vertex AI is wired (lib/ai/types.ts
# is the port both implement, so switching is one env var).
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_TIMEOUT_MS=300000

# Browser origins allowed to call this API directly (comma-separated).
# Must include every host the frontend is served from. Defaults to
# http://localhost:3003 when unset.
CORS_ORIGINS=http://localhost:3003

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Shared secret for the routes that must not be open to the internet: the three
# POST /run endpoints, the user/notification/techstack writes, and the private
# GET /api/tors/:id/grade. Sent by the caller as an X-Admin-Token header.
#
# This is NOT user auth — it identifies nobody. It is the smallest thing that
# stops an anonymous caller from saturating the box or deleting rows, until
# real auth lands (FR-01).
#
# Required in production: the server refuses to boot without it. Optional in
# development, where an unset value means those routes stay open.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Rate limits — requests per IP, per window. Defaults shown.
# ---------------------------------------------------------------------------
# Counters are per-process and held in memory, so running more than one replica
# multiplies the effective limit by the replica count.
#
# Public browsing (GET /api/tors/*), per minute.
RATE_LIMIT_READ_MAX=120
# Pipeline and run status polling by the admin UI, per minute.
RATE_LIMIT_PIPELINE_MAX=60
# CRUD on user/notification/techstack, per minute.
RATE_LIMIT_WRITE_MAX=20
# Starting pipeline work (POST /api/*/run), per HOUR. Each run costs minutes of
# GPU or polite-fetch time, so this is deliberately near zero.
RATE_LIMIT_RUN_MAX=2
