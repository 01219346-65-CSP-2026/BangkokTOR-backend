NODE_ENV=development
PORT=8003

# Local docker-compose mongo; swap for an Atlas SRV URI in prod.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bangkoktor

# Set to "true" to log every mongoose query (dev only).
MONGOOSE_DEBUG=false

# politeFetch (NFR-07) — the only door out to a government host.
# The UA must carry a real contact address; it is how a portal owner reaches us
# instead of blocking us.
HTTP_USER_AGENT=BangkokTOR/0.1 (+mailto:you@example.com)
# Minimum gap between two requests to the SAME host.
HTTP_DELAY_MS=400
HTTP_TIMEOUT_MS=30000
# Total tries, not retries. 1 means never retry.
HTTP_MAX_ATTEMPTS=4
