{
  "name": "bangkoktor-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "discover": "bun run src/discover.ts",
    "worker": "bun run src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "extract-worker": "bun run src/extract-worker.ts",
    "grade-worker": "bun run src/grade-worker.ts",
    "backfill-pdfs": "bun run src/backfill-pdfs.ts",
    "backfill-skills": "bun run src/backfill-skills.ts",
    "purge-out-of-scope": "bun run src/purge-out-of-scope.ts",
    "backfill-classify": "bun run src/backfill-classify.ts",
    "refresh-bidding": "bun run src/refresh-bidding.ts",
    "backup-collections": "bun run src/backup-collections.ts",
    "move-national-out": "bun run src/move-national-out.ts",
    "restore-from-backup": "bun run src/restore-from-backup.ts",
    "cleanup-document-files": "bun run src/cleanup-document-files.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opendataloader/pdf": "^2.5.7",
